{
  "openapi": "3.1.0",
  "info": {
    "title": "Voicebot Backend Service",
    "description": "\n    Backend API for the Nixxis Voicebot.\n    \n    ## Features\n    *   **Authentication**: JWT for Users (Admin/Staff) and API Key for Bots.\n    *   **Calls**: Manage call sessions, check duration limits, and upload recordings/transcripts.\n    *   **Prompts**: Configure System Prompts, including Voice Settings (TTS) and VAD/Idle parameters.\n    *   **Customers**: Manage Callback Requests.\n    \n    ## Usage\n    *   Use the **Authorize** button with your JWT (for Users) or API Key (for Bot operations).\n    ",
    "version": "1.0.0"
  },
  "paths": {
    "/token": {
      "post": {
        "summary": "Login (Get Token)",
        "description": "Authenticate using OAuth2 Password Flow to get a JWT access token. Required for most user/admin operations.",
        "operationId": "login_for_access_token_token_post",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/Body_login_for_access_token_token_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Token"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
